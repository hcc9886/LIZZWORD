    "senses": [
      {
        "no": "01",
        "title": "The act of making amends",
        "titleCN": "赎罪；弥补",
        "definition": "repayment or reparation for injury or wrong",
        "definitionCN": "对伤害或过错的偿还与补救",
        "example": "Rebuilding the school was his atonement.",
        "exampleCN": "重建学校便是他的赎罪。",
        "why": "From at one: amends reunite what the wrong divided.",
        "whyCN": "源自 at one：弥补使被过错拆散者重聚。"
      },
      {
        "no": "02",
        "title": "Religious reconciliation with God",
        "titleCN": "（神学）救赎；和解",
        "definition": "the reconciling of God and humanity, especially through sacrifice",
        "definitionCN": "神人与解，尤指藉献祭达成的救赎",
        "example": "The sermon spoke of atonement through sacrifice.",
        "exampleCN": "布道讲到藉献祭而得的救赎。",
        "why": "Theology kept the oldest sense: sin tears, sacrifice restores oneness.",
        "whyCN": "神学保留了最古老的意义：罪使人撕裂，献祭恢复合一。"
      }
    ],
    "etymology": {
      "intro": {
        "en": "Atonement is at one plus -ment, first written as two words meaning reconciliation, later fused into one theological term.",
        "cn": "atonement 由 at one 加 -ment 构成，初作两词写作、意为和解，后凝缩为神学术语。"
      },
      "items": [
        {
          "era": "OLD ENGLISH",
          "en": "An meant one.",
          "cn": "古英语 an 意为一。"
        },
        {
          "era": "MIDDLE ENGLISH",
          "en": "At one described setting disputants at unity.",
          "cn": "中古英语 at one 表示使争执者归于一体。"
        },
        {
          "era": "ENGLISH, 16TH C.",
          "en": "Tyndale coined atonement to render Greek reconciliation in the New Testament.",
          "cn": "十六世纪廷代尔以 atonement 翻译《新约》中的「和好」一词。"
        },
        {
          "era": "EARLY MODERN ENGLISH",
          "en": "It became the fixed theological noun for Christ's reconciling work.",
          "cn": "它成为指基督救赎之工的固定神学名词。"
        },
        {
          "era": "MODERN ENGLISH",
          "en": "Everyday use now covers any formal or moral amends.",
          "cn": "如今日常用法泛指一切正式或道德上的补偿。"
        }
      ]
