        "no": "01",
        "title": "An officer attached to an embassy",
        "titleCN": "使馆专员；随员",
        "definition": "a junior diplomat assigned special duties at an embassy",
        "definitionCN": "使馆中被派任专项职务的中级外交官",
        "example": "The naval attache attended the fleet review.",
        "exampleCN": "海军武官出席了舰队阅兵。",
        "why": "French attacher means to attach: the officer is attached to the mission.",
        "whyCN": "法语 attacher 意为「使附属于」：专员是被「派附」到使馆的人员。"
      },
      {
        "no": "02",
        "title": "A light rectangular briefcase",
        "titleCN": "手提公文包",
        "definition": "a slim leather case for documents, an attache case",
        "definitionCN": "装文件的轻薄皮包，即 attache case",
        "example": "He set the attache on the desk and unlocked it.",
        "exampleCN": "他把公文包放在桌上并打开。",
        "why": "The case carried by such officers gave its name to the bag.",
        "whyCN": "这类专员随身携带的皮包反过来命名了这种包。"
      }
    ],
    "etymology": {
      "intro": {
        "en": "Attache is the French past participle of attacher, to attach, meaning an officer attached to a diplomatic mission.",
        "cn": "attache 是法语动词 attacher（使附属于）的过去分词，指被派附到外交使团的官员。"
      },
      "items": [
        {
          "era": "PROTO-INDO-EUROPEAN",
          "en": "The root *stedh- meant to stand, be firm.",
          "cn": "词根 *stedh- 意为站立、稳固。"
        },
        {
          "era": "LATIN",
          "en": "Stigare or stingere evolved into stake-related senses.",
          "cn": "拉丁语经演变与「桩、系」义相关。"
        },
        {
          "era": "OLD FRENCH",
          "en": "Estachier meant to fasten with a stake.",
          "cn": "古法语 estachier 意为用桩固定。"
        },
        {
          "era": "FRENCH",
          "en": "Attacher meant to tie, fasten, or assign; attache named the attached officer.",
          "cn": "法语 attacher 意为系、固定、委派；attache 指被派附的官员。"
        },
        {
          "era": "ENGLISH, 19TH C.",
          "en": "English borrowed attache for diplomatic staff, then for their slim briefcase.",
          "cn": "十九世纪英语借入 attache 指外交人员，后亦指其轻薄公文包。"
        }
      ]
    },
