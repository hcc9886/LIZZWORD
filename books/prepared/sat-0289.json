    "senses": [
      {
        "no": "01",
        "title": "To make amends for wrongdoing",
        "titleCN": "赎罪；弥补过错",
        "definition": "to do something good as payment for a wrong",
        "definitionCN": "以善行偿还所犯的过错",
        "example": "She atoned for the betrayal with years of loyal service.",
        "exampleCN": "她以多年的忠诚服务弥补那次背叛。",
        "why": "At one means set at one: wrong splits people, amends reunite them.",
        "whyCN": "at one 意为「合而为一」：过错使人分裂，弥补使人重归于好。"
      },
      {
        "no": "02",
        "title": "To pay a penalty or price",
        "titleCN": "付出代价；抵偿",
        "definition": "to suffer or pay in return for harm done",
        "definitionCN": "为造成的伤害承受或付出代价",
        "example": "The whole town atoned for one man's greed.",
        "exampleCN": "全城为一个人的贪婪付出代价。",
        "why": "Restoring oneness requires balancing the scales again.",
        "whyCN": "恢复「合一」需要把失衡的天平重新摆平。"
      }
    ],
    "etymology": {
      "intro": {
        "en": "Atone began as the phrase at one, set at one, a Middle English rendering of religious reconciliation.",
        "cn": "atone 始于短语 at one（使合而为一），是中古英语对宗教性和解的表达。"
      },
      "items": [
        {
          "era": "OLD ENGLISH",
          "en": "An meant one; at an meant in union.",
          "cn": "古英语 an 意为一；at an 意为合于一体。"
        },
        {
          "era": "MIDDLE ENGLISH",
          "en": "At one described reconciling parties in dispute.",
          "cn": "中古英语 at one 描述使争执双方和解。"
        },
        {
          "era": "ENGLISH, 16TH C.",
          "en": "The phrase fused into the verb atone, tied to theology.",
          "cn": "十六世纪短语凝缩为动词 atone，与神学紧密相连。"
        },
        {
          "era": "EARLY MODERN ENGLISH",
          "en": "Atonement named Christ's reconciling sacrifice.",
          "cn": "atonement 指基督的和解性献祭。"
        },
        {
          "era": "MODERN ENGLISH",
          "en": "Secular uses now cover any making of amends.",
          "cn": "如今世俗用法泛指一切补偿过失之举。"
        }
      ]
    },
