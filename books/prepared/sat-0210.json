    "senses": [
      {
        "no": "01",
        "title": "About, before a number",
        "titleCN": "大约（用于数量或时间）",
        "definition": "used to give a figure that is close to the true one",
        "definitionCN": "给出一个接近真实值的数字",
        "example": "The repair will take approximately three days.",
        "exampleCN": "这次修理大约要三天。",
        "why": "The suffix -ly turns the adjective approximate into a marker placed before figures that are nearest rather than exact.",
        "whyCN": "后缀 -ly 把形容词 approximate 变成标记词，专门放在那些「最接近而非精确」的数字前面。"
      },
      {
        "no": "02",
        "title": "In a broadly similar way",
        "titleCN": "大致上；大体相当地",
        "definition": "used when two things are nearly, but not exactly, the same",
        "definitionCN": "用于说明两件事大体相同但并不完全一致",
        "example": "The two methods are approximately equivalent in cost.",
        "exampleCN": "这两种方法在成本上大致相当。",
        "why": "From counting, the word extends to comparing qualities: two things may stand near each other without matching exactly.",
        "whyCN": "从计数扩展到性质比较：两样东西可以彼此靠得很近，却并不完全吻合。"
      }
    ],
