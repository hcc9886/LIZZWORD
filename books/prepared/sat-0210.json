    "mnemonics": {
      "normalIntro": {
        "en": "Approximately softens a number so it is not a promise.",
        "cn": "approximately 让数字变得柔和，不再像承诺。"
      },
      "normal": [
        {
          "en": "It usually sits right before the figure.",
          "cn": "它通常紧挨在数字前面。"
        },
        {
          "en": "In speech people often shorten it to about.",
          "cn": "口语里人们常把它换成 about。"
        },
        {
          "en": "The adjective form drops the -ly.",
          "cn": "形容词形式去掉 -ly。"
        },
        {
          "en": "It can also compare two things as broadly equal.",
          "cn": "它也能表示两件事大体相等。"
        },
        {
          "en": "Stress the second syllable: ap-PROX-i-mate-ly.",
          "cn": "重音在第二个音节：ap-PROX-i-mate-ly。"
        }
      ],
      "abstract": [
        {
          "en": "See a needle stopping a hair below the mark.",
          "cn": "想象指针停在刻度下方一点点。"
        },
        {
          "en": "See two lines that almost, not quite, meet.",
          "cn": "想象两条几乎相接却未相接的线。"
        },
        {
          "en": "See a hand waving to mean roughly so.",
          "cn": "想象一只手左右摆动表示大概如此。"
        }
      ]
