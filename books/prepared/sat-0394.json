    "senses": [
      {
        "no": "01",
        "title": "To ask eagerly and anxiously",
        "titleCN": "恳求；哀求",
        "definition": "to beg someone earnestly, often with urgency or distress",
        "definitionCN": "急切而焦虑地向人恳求，常带迫切与痛苦",
        "example": "The prisoner beseeched the judge for one more chance.",
        "exampleCN": "囚犯恳求法官再给一次机会。",
        "why": "Be- strengthens seek, so it is seeking with all one's heart.",
        "whyCN": "前缀 be- 强化 seek（寻求），即全心全力地求。"
      },
      {
        "no": "02",
        "title": "To entreat as in prayer or formal speech",
        "titleCN": "祈求；恳请（正式）",
        "definition": "to make an earnest appeal, as in prayers or old-fashioned letters",
        "definitionCN": "如祈祷或旧式书信中的郑重恳请",
        "example": "I beseech you to hear my whole defence.",
        "exampleCN": "我恳请您听完我的全部申辩。",
        "why": "The urgent seeking rises into solemn appeal.",
        "whyCN": "急切的「求」升格为庄重的「恳请」。"
      }
    ],
    "etymology": {
      "intro": {
        "en": "Beseech is the prefix be- plus seek, an Old English verb of searching.",
        "cn": "beseech 由前缀 be- 加 seek 构成，seek 是古英语表「寻找」的动词。"
      },
      "items": [
        {
          "era": "PROTO-INDO-EUROPEAN",
          "en": "the root sag- meant to track down, to seek out.",
          "cn": "词根 sag- 意为「追踪、寻出」（重构形式）。"
        },
        {
          "era": "OLD ENGLISH",
          "en": "secan meant to seek, to visit, to pursue.",
          "cn": "古英语 secan 意为「寻找、拜访、追寻」。"
        },
        {
          "era": "MIDDLE ENGLISH",
          "en": "beseken meant to seek earnestly, to entreat.",
          "cn": "中古英语 beseken 意为「恳切寻求、恳求」。"
        },
        {
          "era": "ENGLISH, 13TH C.",
          "en": "beseech settled in the thirteenth century as a solemn begging word.",
          "cn": "十三世纪 beseech 定型为庄重的恳求词。"
        },
        {
          "era": "MODERN ENGLISH",
          "en": "it now sounds literary, with the irregular form besought alongside beseeched.",
          "cn": "如今略显书面，不规则形式 besought 与 beseeched 并存。"
        }
      ]
