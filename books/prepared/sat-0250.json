        "titleCN": "驴的；似驴的",
        "definition": "relating to or resembling an ass or donkey",
        "definitionCN": "与驴相关或似驴的",
        "example": "In zoology texts, asinine describes the donkey family.",
        "exampleCN": "在动物学文献中，asinine 描述驴科动物。",
        "why": "The word keeps its literal animal sense in scientific contexts.",
        "whyCN": "在科学语境中，该词保留了字面的动物义。"
      }
    ],
    "etymology": {
      "intro": {
        "en": "Asinine comes from Latin asinus, donkey, with the adjective suffix -inus.",
        "cn": "asinine 源自拉丁语 asinus（驴），加形容词后缀 -inus 构成。"
      },
      "items": [
        {
          "era": "PROTO-INDO-EUROPEAN",
          "en": "The root *as- may name the wild ass of ancient steppe lands; the origin is generally thought so but not certain.",
          "cn": "词根 *as- 或指古代草原上的野驴；一般认为如此，但不确定。"
        },
        {
          "era": "LATIN",
          "en": "Asinus meant donkey and, by extension, a dull person.",
          "cn": "拉丁语 asinus 指驴，引申指迟钝的人。"
        },
        {
          "era": "LATE LATIN",
          "en": "Asininus meant donkey-like or foolish.",
          "cn": "后期拉丁语 asininus 意为似驴的、愚蠢的。"
        },
        {
          "era": "OLD FRENCH",
          "en": "Old French asin carried the word onward.",
          "cn": "古法语 asin 使该词得以传承。"
        },
        {
          "era": "ENGLISH, 17TH C.",
          "en": "English adopted asinine in the seventeenth century.",
          "cn": "十七世纪英语借入 asinine。"
        }
