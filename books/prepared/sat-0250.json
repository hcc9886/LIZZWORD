    "mnemonics": {
      "normalIntro": {
        "en": "Hear ass inside asinine: acting like a stubborn ass.",
        "cn": "在 asinine 里听出 ass（驴）：像顽固的驴一样行事。"
      },
      "normal": [
        {
          "en": "Latin asinus is the donkey.",
          "cn": "拉丁语 asinus 就是驴。"
        },
        {
          "en": "-ine makes animal adjectives: bovine, leonine, asinine.",
          "cn": "-ine 构成动物形容词：bovine、leonine、asinine。"
        },
        {
          "en": "ass doubled as fool already in Latin slang.",
          "cn": "ass 在拉丁俚语中已兼指蠢人。"
        },
        {
          "en": "compare bovine, cow-like and dull.",
          "cn": "对比 bovine，像牛般迟钝。"
        },
        {
          "en": "it is a strong insult: reserve it for true folly.",
          "cn": "这是很强的贬义词，用于真正的愚蠢。"
        }
