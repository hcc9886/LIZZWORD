      },
      {
        "no": "02",
        "title": "Clever in gaining advantage",
        "titleCN": "精明的；狡黠的",
        "definition": "shrewd in turning insight to practical benefit",
        "definitionCN": "善于把洞察化为实际利益",
        "example": "An astute bargain doubled his holdings.",
        "exampleCN": "一笔精明的交易使他的资产翻倍。",
        "why": "Craft is cunning applied; astuteness shades into shrewd self-interest.",
        "whyCN": "机巧运用于谋利便是狡黠；astute 因此带有精于算计的色彩。"
      }
    ],
