    "senses": [
      {
        "no": "01",
        "title": "To come together in a group",
        "titleCN": "集合；聚集",
        "definition": "to gather people or to gather oneself in one place",
        "definitionCN": "把人聚到一处，或自身聚到一处",
        "example": "The students assembled in the hall before noon.",
        "exampleCN": "学生们中午前在礼堂集合。",
        "why": "Old French assembler came from Latin ad simul, 'to the same place', so the word begins as a gathering.",
        "whyCN": "古法语 assembler 来自拉丁语 ad simul「到同一处」，所以这个词本义就是聚集。"
      },
      {
        "no": "02",
        "title": "To fit parts into a whole",
        "titleCN": "组装；装配",
        "definition": "to put separate pieces together so they work as one",
        "definitionCN": "把分开的部件拼在一起，使其作为一个整体运作",
        "example": "Workers assemble the engines by hand.",
        "exampleCN": "工人们手工组装发动机。",
        "why": "If parts are gathered in the right order, the gathering becomes construction; the same verb serves both.",
        "whyCN": "若把零件按正确次序聚到一起，聚集就成了装配；同一个动词兼指两者。"
      }
    ],
