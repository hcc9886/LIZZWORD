    "mnemonics": {
      "normalIntro": {
        "en": "a + sonance: the son- root is sound; vowels sound alike in assonance.",
        "cn": "a + sonance：词根 son- 是「声音」，元音韵就是元音听起来相像。"
      },
      "normal": [
        {
          "en": "sonare means to sound, as in sonic.",
          "cn": "sonare 意为发声，如 sonic。"
        },
        {
          "en": "only the vowels repeat in assonance.",
          "cn": "元音韵只重复元音。"
        },
        {
          "en": "alliteration repeats first consonants instead.",
          "cn": "头韵重复的则是词首辅音。"
        },
        {
          "en": "dissonance adds dis-, meaning clash.",
          "cn": "dissonance 加 dis- 表示不和谐。"
        },
        {
          "en": "the adjective is assonant.",
          "cn": "形容词形式是 assonant。"
        }
      ],
