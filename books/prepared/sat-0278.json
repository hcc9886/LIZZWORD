    "senses": [
      {
        "no": "01",
        "title": "Repetition of vowel sounds in poetry",
        "titleCN": "元音韵；半谐音",
        "definition": "the repetition of similar vowel sounds within nearby words or lines",
        "definitionCN": "邻近词语或诗行中相似元音的重复",
        "example": "The fleet's wheels swept past in deep assonance.",
        "exampleCN": "诗句里车轮与呼啸的元音交织出浓重的谐音。",
        "why": "Latin ad- plus sonare means to sound toward, so assonance is vowels leaning toward each other in sound.",
        "whyCN": "拉丁语 ad- 加 sonare 意为「向…发声」，元音韵即元音彼此靠拢回响。"
      },
      {
        "no": "02",
        "title": "Resemblance of sounds in language",
        "titleCN": "谐音；音似",
        "definition": "similarity between sounds, especially vowels, in words",
        "definitionCN": "词语之间尤其是元音的音似",
        "example": "The two dialects show striking assonance in their vowels.",
        "exampleCN": "两种方言的元音显示出惊人的谐音。",
        "why": "Sounding toward something becomes sounding like it.",
        "whyCN": "「向对方发声」引申为「听起来像对方」。"
      }
    ],
    "etymology": {
      "intro": {
        "en": "Assonance comes from Latin assonare, to sound toward or answer in sound, from ad- plus sonare.",
        "cn": "assonance 源自拉丁语 assonare（向…发声、应声），出自 ad- 加 sonare。"
      },
      "items": [
        {
          "era": "PROTO-INDO-EUROPEAN",
