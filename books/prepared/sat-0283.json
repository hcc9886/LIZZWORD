    "senses": [
      {
        "no": "01",
        "title": "To shock with the unexpected",
        "titleCN": "使震惊；使惊愕",
        "definition": "to overwhelm someone with sudden surprise",
        "definitionCN": "以突来的意外彻底震住某人",
        "example": "The verdict astounded the courtroom.",
        "exampleCN": "判决令整个法庭愕然。",
        "why": "The Latin root ex-tonare means to thunder out; the shock lands like thunder.",
        "whyCN": "拉丁词根 ex-tonare 意为雷声炸响；震惊正如惊雷落地。"
      },
      {
        "no": "02",
        "title": "To overwhelm with wonder",
        "titleCN": "使惊叹；令人叹服",
        "definition": "to fill someone with amazed admiration",
        "definitionCN": "以惊叹与叹服充满内心",
        "example": "The acrobats astounded everyone with their balance.",
        "exampleCN": "杂技演员的平衡技令所有人叹服。",
        "why": "Thunder becomes awe when the surprise is also splendid.",
        "whyCN": "当意外同时精彩绝伦，惊雷便化作惊叹。"
      }
    ],
    "etymology": {
      "intro": {
        "en": "Astound arose in English around the seventeenth century, blending astonish and stun, both from Latin ex-tonare, to thunder out.",
        "cn": "astound 约于十七世纪在英语中出现，混合了 astonish 与 stun，二者均源自拉丁语 ex-tonare（如雷声般炸响）。"
      },
      "items": [
        {
          "era": "PROTO-INDO-EUROPEAN",
          "en": "The root *(s)ten- meant to thunder or resound.",
          "cn": "词根 *(s)ten- 意为打雷、轰鸣。"
        },
        {
          "era": "LATIN",
          "en": "Extontanare meant to thunder out, to stun.",
          "cn": "拉丁语 extontanare 意为如雷炸响、令人失神。"
        },
        {
          "era": "OLD FRENCH",
          "en": "Estoner passed into English as astonish.",
          "cn": "古法语 estoner 进入英语成为 astonish。"
        },
        {
          "era": "ENGLISH, 16TH C.",
          "en": "Stun developed as a native short form of the thunder idea.",
          "cn": "十六世纪英语中 stun 发展为「雷击般失神」的简短形式。"
        },
        {
          "era": "ENGLISH, 17TH C.",
          "en": "Astound blended the two, first as a past participle, then a full verb.",
          "cn": "十七世纪 astound 由二者混合而成，先作过去分词，后成完整动词。"
        }
      ]
    },
