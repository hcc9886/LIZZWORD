    "senses": [
      {
        "no": "01",
        "title": "To ease a painful feeling",
        "titleCN": "缓和；减轻",
        "definition": "to make grief, fear, or pain less intense",
        "definitionCN": "使悲伤、恐惧或痛苦变得不那么强烈",
        "example": "A warm meal can assuage sorrow for a while.",
        "exampleCN": "一顿热饭能暂时抚慰悲伤。",
        "why": "Latin suavis meant sweet; sweetening a harsh feeling softens it.",
        "whyCN": "拉丁语 suavis 意为甜；给苦涩的情绪加点甜，它就缓和了。"
      },
      {
        "no": "02",
        "title": "To satisfy a desire",
        "titleCN": "满足；平息（欲求）",
        "definition": "to fulfil a craving such as hunger or curiosity",
        "definitionCN": "满足如饥饿、好奇之类的渴求",
        "example": "Nothing could assuage his hunger for news.",
        "exampleCN": "什么都满足不了他对消息的渴求。",
        "why": "A craving is an inner turbulence; satisfying it calms the surge.",
        "whyCN": "渴求是内心的翻腾；满足它便平息了这股涌动。"
      }
    ],
    "etymology": {
      "intro": {
        "en": "Assuage comes from Old French asuagier, from Vulgar Latin *assuaviare, to sweeten, from Latin suavis.",
        "cn": "assuage 源自古法语 asuagier，出自通俗拉丁语 *assuaviare（使变甜），词根为拉丁语 suavis（甜的）。"
      },
      "items": [
        {
          "era": "PROTO-INDO-EUROPEAN",
          "en": "The root *swād- meant sweet.",
          "cn": "词根 *swād- 意为甜。"
        },
        {
          "era": "LATIN",
          "en": "Suavis meant sweet, pleasant.",
          "cn": "拉丁语 suavis 意为甜的、令人愉快的。"
        },
        {
          "era": "VULGAR LATIN",
          "en": "Assuaviare meant to make sweet, hence to soften.",
          "cn": "通俗拉丁语 assuaviare 意为使变甜，进而引申为使缓和。"
        },
        {
          "era": "OLD FRENCH",
          "en": "Asuagier meant to calm or appease.",
          "cn": "古法语 asuagier 意为使平静、安抚。"
        },
        {
          "era": "ENGLISH, 14TH C.",
          "en": "English adopted assuage in the fourteenth century.",
          "cn": "十四世纪英语借入 assuage。"
        }
      ]
    },
